# Bloomberry / revealera (https://bloomberry.com/signup.html) — optional, first
# source in the GTM job digest waterfall. Free tier gives 200 credits. If unset,
# the digest skips straight to Remotive.
BLOOMBERRY_API_KEY=

# Resend (https://resend.com) — email delivery for the GTM job digest
RESEND_API_KEY=

# Recipient — must be the email address that owns the Resend account
# until a custom domain is verified in Resend
DIGEST_TO_EMAIL=chetanmuley01@gmail.com

# Sender — must stay onboarding@resend.dev until a custom domain is verified
RESEND_FROM_EMAIL=onboarding@resend.dev
